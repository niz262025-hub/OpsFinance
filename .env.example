NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Staged SSO only. Both flags must agree. Production activation is deliberately blocked.
MYOPS_SSO_ENABLED=false
NEXT_PUBLIC_MYOPS_SSO_ENABLED=false
OPSFINANCE_ORIGIN=
MYOPS_ORIGIN=
# Ed25519 PKCS8 PEM; enroll corresponding public key with MYOPS, app ID opsfinance.
MYOPS_APP_PRIVATE_KEY=
# Independent high-entropy encryption key, at least 32 characters; server-only.
MYOPS_APP_SESSION_SECRET=
# Server-only broker credential; provision its SHA-256 digest in the private gate config.
MYOPS_DATA_BROKER_KEY=
# Optional expiring Vercel preview share access; never used or provisioned in production.
MYOPS_STAGING_SHARE_TOKEN=
